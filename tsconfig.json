{
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ]
  },
  "skipIgnore": true,
  "compilerOptions": {
    "outDir": "./dist",
    "sourceMap": true,
    "module": "esnext",
    "target": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "lib": [
      "esnext",
      "dom"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "*"
      ],
      "@daemonitor/common/*": [
        "node_modules/@daemonitor/common/*"
      ],
      "@daemonitor/plugins/*": [
        "node_modules/@daemonitor/plugins/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@daemonitor/common/types",
      "./node_modules/@daemonitor/plugins/types",
      "./types"
    ]
  },
  "include": [
    "**/*.ts",
    "node_modules/@daemonitor/common/index.ts",
    "node_modules/@daemonitor/plugins/index.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
