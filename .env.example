# Daemonitor Client Environment Variables

# System Key (required)
# This is used to authenticate with the Daemonitor server
SYSTEM_KEY=your-system-key-here

# API Base URL (optional)
# The base URL for the Daemonitor API
# Defaults to https://daemonitor.com/api
API_BASE_URL=http://localhost:3000/api

# Ewelink Configuration (optional)
EWELINK_EMAIL=your-ewelink-email
EWELINK_PASSWORD=your-ewelink-password
EWELINK_REGION=us

# MongoDB Configuration (optional)
MONGODB_URI=mongodb://localhost:27017

# Advanced Configuration (optional)
LOG_LEVEL=info
REFRESH_INTERVAL=60000
