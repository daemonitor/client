{
  "connectors": [
    {
      "type": "rest-api",
      "name": "REST API",
      "config": {
        "apiUrl": "http://localhost:3000/api/clientstate/update",
        "systemKey": "YOUR SYSTEM KEY HERE"
      }
    }
  ],
  "plugins": [
    "pm2",
    "os",
    "web",
    "ewelink",
    "docker",
    "lxc",
    "mongodb",
    "cloudflare",
    "wordpress",
    "logwatch",
    "patroni"
  ],
  "ewelink": {
    "name": "ewelink",
    "uniqueId": "ewelink",
    "refreshInterval": 10000,
    "email": "your-ewelink-email@example.com",
    "password": "your-ewelink-password",
    "region": "us",
    "devices": []
  },
  "pm2": {
    "name": "pm2",
    "uniqueId": "pm2",
    "refreshInterval": 10000,
    "processes": []
  },
  "docker": {
    "name": "docker",
    "uniqueId": "docker",
    "refreshInterval": 60000,
    "dockerBin": "docker",
    "projects": [],
    "exclude": []
  },
  "patroni": {
    "_comment": "Runs ON a Patroni node and reads its local REST API (unauthenticated GETs by default). /patroni gives this node's own role, which is how daemonitor learns which host is the leader; /cluster gives every member's role, state and replication lag. Required for cluster placement 'leader' — without it, 'leader' can only be enforced as 'exactly one member'.",
    "name": "patroni",
    "uniqueId": "patroni",
    "refreshInterval": 30000,
    "url": "http://localhost:8008",
    "lagWarnBytes": 33554432,
    "lagCritBytes": 268435456
  },
  "lxc": {
    "name": "lxc",
    "uniqueId": "lxc",
    "refreshInterval": 60000,
    "lxcBin": "lxc",
    "instances": [],
    "exclude": []
  },
  "mongodb": {
    "name": "mongodb",
    "uniqueId": "mongodb",
    "refreshInterval": 30000,
    "uri": "mongodb://localhost:27017",
    "databases": []
  },
  "os": {
    "name": "os",
    "uniqueId": "os",
    "refreshInterval": 30000
  },
  "web": {
    "name": "web",
    "uniqueId": "web",
    "refreshInterval": 60000,
    "endpoints": [
      {
        "name": "Example Website",
        "url": "https://example.com",
        "expectedStrings": [
          "Example Domain"
        ]
      },
      {
        "name": "Another Website",
        "url": "https://another-example.com",
        "unexpectedStrings": [
          "Error",
          "Bad Gateway"
        ],
        "expectedStatusCode": 200,
        "timeout": 5000
      },
      {
        "_comment": "Security example: unexpectedStrings doubles as an IOC list (injected-script id, known malware domain) -> a match flips the check to a 'Possible compromise' alert naming the matched string. expectedStrings doubles as an integrity canary -> its absence flips to 'Possible defacement'.",
        "name": "Client Site (integrity)",
        "url": "https://client-site.example",
        "unexpectedStrings": [
          "id=\"_ea_s\"",
          "estrelamardedetizadora.com"
        ],
        "expectedStrings": [
          "© Client Site"
        ]
      },
      {
        "_comment": "Posture: xmlrpc should be blocked at the edge. Set expectedStatusCode to the code your block returns (403) so a reachable 200/405 flips the check.",
        "name": "Client Site xmlrpc (should be blocked)",
        "url": "https://client-site.example/xmlrpc.php",
        "expectedStatusCode": 403
      }
    ]
  },
  "cloudflare": {
    "name": "Cloudflare Deployments",
    "uniqueId": "cloudflare",
    "refreshInterval": 60000,
    "reportingKey": "your-daemonitor-cloudflare-reporting-key",
    "maxDataAge": 300000
  },
  "wordpress": {
    "_comment": "Runs on the WP host via WP-CLI + filesystem + crontab. runAs is the OS user WP-CLI runs as (it refuses root); cronUser is the web user whose crontab should be empty. Diffs (new admin / demotion) are computed server-side against the prior snapshot.",
    "name": "wordpress",
    "uniqueId": "wordpress",
    "refreshInterval": 300000,
    "sites": [
      {
        "name": "Client Site",
        "path": "/var/www/client-site",
        "url": "https://client-site.example",
        "runAs": "www-data",
        "cronUser": "www-data",
        "criticalPages": ["login", "home"],
        "servicePatterns": ["wpsvc", "wpengine", "bot", "svc", "researchlabs"],
        "muPluginsAllowlist": []
      }
    ]
  },
  "logwatch": {
    "_comment": "Tails access logs for WP2Shell (batch/v1->207), webshell exec, xmlrpc bursts, and batch->login correlation. The log MUST record the real client IP — behind Cloudflare configure nginx real_ip (CF-Connecting-IP) so findings point at the visitor, not the CF edge. Starts tailing from the current end unless fromStart:true.",
    "name": "logwatch",
    "uniqueId": "logwatch",
    "refreshInterval": 60000,
    "xmlrpcBurstThreshold": 20,
    "sources": [
      {
        "name": "client-site access",
        "path": "/var/log/nginx/client-site.access.log"
      }
    ]
  }
}
